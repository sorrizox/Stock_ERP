PORT=3333

# Gere uma chave longa e aleatória. Use o mesmo valor em
# EXTERNAL_ERP_API_TOKEN no site.
CONNECTOR_TOKEN=troque-por-uma-chave-forte

# Valores aceitos: mysql2, pg ou mssql
DB_CLIENT=mysql2

# Exemplos:
# MySQL:      mysql://usuario:senha@127.0.0.1:3306/estoque
# PostgreSQL: postgres://usuario:senha@127.0.0.1:5432/estoque
# SQL Server: mssql://usuario:senha@127.0.0.1:1433/estoque
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/estoque

# Opcional para SQL Server com certificado interno.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Opcional: caminho para um JSON que substitui nomes de tabelas.
TABLE_MAP_FILE=./config/table-map.json
