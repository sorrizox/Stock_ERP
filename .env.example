# Fonte de dados: "d1" mantém o banco interno; "external-api" usa o conector.
ERP_DATA_SOURCE=d1
STOCK_ERP_DEFAULT_USER=admin@stockerp.local
STOCK_ERP_DEFAULT_NAME=Administrador Stock ERP

# Informe a URL completa do conector somente no servidor/hospedagem.
# Exemplo: https://erp-api.suaempresa.com/api/erp
EXTERNAL_ERP_API_URL=

# Use o mesmo valor definido em CONNECTOR_TOKEN no conector.
EXTERNAL_ERP_API_TOKEN=
